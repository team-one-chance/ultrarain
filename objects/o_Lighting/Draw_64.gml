// Temporary resolution readout; drawn after world pixelation so text stays sharp.
if (!enabled || resolution_indicator_timer <= 0 || !view_enabled) exit;
var _cam = view_camera[0];
if (_cam == -1) exit;
var _size = pixelation_enabled ? pixelation_size : 1;
var _width = ceil(camera_get_view_width(_cam) / _size);
var _height = ceil(camera_get_view_height(_cam) / _size);
var _color = draw_get_color();
var _alpha = draw_get_alpha();
var _font = draw_get_font();
var _halign = draw_get_halign();
var _valign = draw_get_valign();
draw_set_font(f_Console);
draw_set_halign(fa_left);
draw_set_valign(fa_top);
var _label = "World resolution: " + string(_width) + " x " + string(_height);
var _detail = "Pixel size: " + string_format(_size, 0, 1) + "   N: toggle";
var _padding = 12;
var _panel_width = max(string_width(_label), string_width(_detail)) + _padding * 2;
var _line_height = string_height(_label) + 4;
var _left = display_get_gui_width() - _panel_width - 16;
var _top = 16;
draw_set_alpha(0.8);
draw_set_color(c_black);
draw_rectangle(_left, _top, _left + _panel_width, _top + _line_height * 2 + _padding * 2, false);
draw_set_alpha(1);
draw_set_color(c_white);
draw_text(_left + _padding, _top + _padding, _label);
draw_text(_left + _padding, _top + _padding + _line_height, _detail);
draw_set_color(_color);
draw_set_alpha(_alpha);
draw_set_font(_font);
draw_set_halign(_halign);
draw_set_valign(_valign);
